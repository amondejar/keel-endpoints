<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Contracts are discovered for .NET 10 validation through [ValidatableType]. -->
    <NoWarn>$(NoWarn);ASP0029</NoWarn>
  </PropertyGroup>

  <!-- OpenAPI document and Scalar API reference (see ApiReference.cs). Skipped in offline builds. -->
  <ItemGroup Condition="'$(KeelOfflineRoslyn)' != 'true'">
    <!-- 10.0.10 or later: what Asp.Versioning.OpenApi needs. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- It still brings Microsoft.OpenApi 2.0.0: pin past GHSA-v5pm-xwqc-g5wc (fixed in 2.7.5). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
  </ItemGroup>
  <PropertyGroup Condition="'$(KeelOfflineRoslyn)' != 'true'">
    <DefineConstants>$(DefineConstants);KEEL_OPENAPI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Keel.Endpoints\Keel.Endpoints.csproj" />
    <!-- In a project that uses the NuGet package the analyzers come with it; here they are referenced directly. -->
    <ProjectReference Include="..\..\src\Keel.Endpoints.Analyzers\Keel.Endpoints.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
