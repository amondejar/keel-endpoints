<Project>
  <!-- Central package management: every version in one place. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <KeelVersion>1.0.0-rc.1</KeelVersion>
  </PropertyGroup>

  <ItemGroup Label="Keel.Endpoints">
    <PackageVersion Include="Keel.Endpoints" Version="$(KeelVersion)" />
    <PackageVersion Include="Keel.Endpoints.FluentValidation" Version="$(KeelVersion)" />
    <PackageVersion Include="Keel.Endpoints.Idempotency" Version="$(KeelVersion)" />
    <PackageVersion Include="Keel.Endpoints.OpenTelemetry" Version="$(KeelVersion)" />
    <PackageVersion Include="Keel.Endpoints.Versioning" Version="$(KeelVersion)" />
    <PackageVersion Include="Keel.Endpoints.Testing" Version="$(KeelVersion)" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.0" />
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.0" />
    <!-- At least the version Asp.Versioning.OpenApi needs. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- It still brings Microsoft.OpenApi 2.0.0: pin past GHSA-v5pm-xwqc-g5wc (fixed in 2.7.5). -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.0" />
  </ItemGroup>

  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="3.2.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>
</Project>
