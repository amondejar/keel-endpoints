<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Keel.Endpoints.Mcp</PackageId>
    <Description>Keel.Endpoints endpoint classes as MCP (Model Context Protocol) tools for AI agents, on the official MCP C# SDK: opt-in per endpoint, input and output schemas from the request and response contracts, and every call runs the real endpoint in process (binding, validation, ProblemDetails) under the same authorization, with the caller's identity. Writes must say whether they are destructive.</Description>
    <PackageTags>$(PackageTags);mcp;model-context-protocol;ai-agents;tools</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- New package: there is no published version to compare with yet (Directory.Build.targets). -->
    <KeelPackageValidation>false</KeelPackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keel.Endpoints\Keel.Endpoints.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Keel.Endpoints.Tests" />
    <InternalsVisibleTo Include="Keel.Endpoints.Agents" />
  </ItemGroup>

</Project>
