<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- [ValidatableType] is marked experimental in .NET 10. -->
    <NoWarn>$(NoWarn);ASP0029</NoWarn>
<!--#if (aot) -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
<!--#endif -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Keel.Endpoints" Version="KEEL_PACKAGE_VERSION" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!-- Pins the transitive Microsoft.OpenApi past GHSA-v5pm-xwqc-g5wc (fixed in 2.7.5). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
  </ItemGroup>

</Project>
