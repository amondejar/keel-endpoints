<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- [ValidatableType] is marked experimental in .NET 10. -->
    <NoWarn>$(NoWarn);ASP0029</NoWarn>
<!--#if (aot) -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
<!--#endif -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Keel.Endpoints" Version="KEEL_PACKAGE_VERSION" />
    <!-- 10.0.10 or later: it brings a patched Microsoft.OpenApi, and Asp.Versioning.OpenApi needs it. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
  </ItemGroup>

</Project>
