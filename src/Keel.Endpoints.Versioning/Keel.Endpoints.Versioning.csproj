<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Keel.Endpoints.Versioning</PackageId>
    <Description>API versioning for Keel.Endpoints on top of Asp.Versioning: a version per folder (Features/V2/...), unique operation names per version, and [ApiVersion] on endpoint classes. Versioned routes, version headers and deprecation stay Asp.Versioning's.</Description>
    <PackageTags>$(PackageTags);versioning;api-versioning</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Asp.Versioning.Http" Version="10.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keel.Endpoints\Keel.Endpoints.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Keel.Endpoints.Tests" />
  </ItemGroup>

</Project>
