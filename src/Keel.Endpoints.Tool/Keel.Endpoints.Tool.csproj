<Project Sdk="Microsoft.NET.Sdk">

  <!--
    dotnet-keel: compares api.manifest.json between two git refs (or two files) and reports what changed
    for clients. Installed as a .NET tool: `dotnet keel diff v1.0.0 HEAD`.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-keel</ToolCommandName>
    <PackageId>Keel.Endpoints.Tool</PackageId>
    <RollForward>Major</RollForward>
    <Description>dotnet keel diff: compares the api.manifest.json of two git refs or two files and lists breaking, security and compatible changes, as text, Markdown (for pull request comments and release notes) or JSON. Exits non-zero on breaking changes when asked to.</Description>
    <PackageTags>$(PackageTags);dotnet-tool;api-diff;breaking-changes</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keel.Endpoints.Testing\Keel.Endpoints.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Keel.Endpoints.Tests" />
  </ItemGroup>

</Project>
